{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "split.schema.json",
  "title": "SplitOp",
  "description": "Splits audio into multiple segments",
  "type": "object",
  "allOf": [{ "$ref": "baseOperation.schema.json" }],
  "required": ["kind", "sources", "params"],
  "properties": {
    "kind": {
      "const": "split"
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "operationSource.schema.json" },
      "minItems": 1,
      "maxItems": 1,
      "description": "Audio source to split (single source only)"
    },
    "params": {
      "type": "object",
      "description": "Split operation parameters",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "description": "Split mode",
          "enum": ["equal_parts", "by_duration", "at_markers", "by_silence"],
          "default": "equal_parts",
          "ui": {
            "control": "select",
            "label": "Split Mode",
            "group": "mode"
          }
        },
        "num_parts": {
          "type": "integer",
          "description": "Number of equal parts to split into",
          "minimum": 2,
          "maximum": 100,
          "default": 2,
          "ui": {
            "control": "number",
            "label": "Number of Parts",
            "group": "mode",
            "showIf": { "mode": "equal_parts" }
          }
        },
        "segment_duration_ms": {
          "type": "integer",
          "description": "Duration of each segment in milliseconds",
          "minimum": 100,
          "default": 30000,
          "ui": {
            "control": "number",
            "label": "Segment Duration (ms)",
            "group": "mode",
            "showIf": { "mode": "by_duration" }
          }
        },
        "markers": {
          "type": "array",
          "description": "Split points in milliseconds",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": [],
          "ui": {
            "control": "marker-list",
            "label": "Split Markers (ms)",
            "group": "mode",
            "showIf": { "mode": "at_markers" }
          }
        },
        "silence_threshold_db": {
          "type": "number",
          "description": "Threshold for silence detection in dB",
          "minimum": -96,
          "maximum": 0,
          "default": -40,
          "ui": {
            "control": "slider",
            "label": "Silence Threshold (dB)",
            "step": 1,
            "group": "mode",
            "showIf": { "mode": "by_silence" }
          }
        },
        "min_silence_duration_ms": {
          "type": "integer",
          "description": "Minimum silence duration to trigger split",
          "minimum": 10,
          "default": 500,
          "ui": {
            "control": "number",
            "label": "Min Silence Duration (ms)",
            "group": "mode",
            "showIf": { "mode": "by_silence" }
          }
        },
        "keep_silence": {
          "type": "boolean",
          "description": "Include silence portions in output",
          "default": false,
          "ui": {
            "control": "checkbox",
            "label": "Keep Silence",
            "group": "mode",
            "showIf": { "mode": "by_silence" }
          }
        },
        "output_format": {
          "type": "string",
          "description": "Output format for split segments",
          "enum": ["wav", "mp3", "flac", "ogg"],
          "default": "wav",
          "ui": {
            "control": "select",
            "label": "Output Format",
            "group": "output"
          }
        },
        "naming_pattern": {
          "type": "string",
          "description": "Pattern for naming output files",
          "default": "{name}_{index:03d}",
          "ui": {
            "control": "text",
            "label": "Naming Pattern",
            "placeholder": "{name}_{index:03d}",
            "group": "output"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
