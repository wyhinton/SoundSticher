{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "normalize.schema.json",
  "title": "NormalizeOp",
  "description": "Normalizes audio levels to a target",
  "type": "object",
  "allOf": [{ "$ref": "baseOperation.schema.json" }],
  "required": ["kind", "sources", "params"],
  "properties": {
    "kind": {
      "const": "normalize"
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "operationSource.schema.json" },
      "minItems": 1,
      "description": "Audio sources to normalize"
    },
    "params": {
      "type": "object",
      "description": "Normalize operation parameters",
      "required": ["target_db"],
      "properties": {
        "target_db": {
          "type": "number",
          "description": "Target peak level in dB",
          "minimum": -60,
          "maximum": 0,
          "default": -3,
          "ui": {
            "control": "slider",
            "label": "Target Level (dB)",
            "step": 0.5,
            "group": "levels"
          }
        },
        "mode": {
          "type": "string",
          "description": "Normalization mode",
          "enum": ["peak", "rms", "lufs"],
          "default": "peak",
          "ui": {
            "control": "select",
            "label": "Mode",
            "group": "levels"
          }
        },
        "preserve_stereo_balance": {
          "type": "boolean",
          "description": "Maintain relative levels between channels",
          "default": true,
          "ui": {
            "control": "checkbox",
            "label": "Preserve Stereo Balance",
            "group": "options"
          }
        },
        "use_true_peak": {
          "type": "boolean",
          "description": "Use true peak detection (more accurate but slower)",
          "default": false,
          "ui": {
            "control": "checkbox",
            "label": "True Peak Detection",
            "group": "options"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
